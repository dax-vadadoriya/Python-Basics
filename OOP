Complete example
class Student:

    school = "GEC Gandhinagar"

    def __init__(self, name, age):
        self.name = name
        self.age = age

    def introduce(self):
        print("Hi, I am", self.name)

    def birthday(self):
        self.age += 1

    def get_age(self):
        return self.age


daksh = Student("Daksh", 20)

print(daksh.name)
print(daksh.age)

daksh.introduce()

daksh.birthday()

print(daksh.get_age())

print(Student.school)
print(daksh.school)










